# Disable browser caching for development so scripts and HTML are always fresh
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Block direct access to backup, source, and sensitive file extensions
<FilesMatch "(?i)\.(bak|inc|old|save|tmp|sql|dump|log|env|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
